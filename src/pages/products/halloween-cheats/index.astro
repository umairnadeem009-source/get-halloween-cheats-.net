---
import '../../../styles/product-cheat-page.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getMainProduct, productHub } from '../../../data/products';
import { pageTitle, socialImageFromAsset } from '../../../config/seo';
import { getPageSeoEntry } from '../../../config/pageSeo';
import { breadcrumbSchema, productSchema } from '../../../utils/schema';
import ProductDetail from '../../../components/ProductDetail.astro';
import { PRODUCT_BASE } from '../../../config/site';

const product = getMainProduct();
const pagePath = PRODUCT_BASE;
const seoEntry = getPageSeoEntry(pagePath);
const metaTitle = seoEntry?.title ?? pageTitle(`Buy ${product.title}`);
const metaDescription =
  seoEntry?.description ??
  `Buy ${product.title} for Windows PC — ${product.desc}`;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: productHub.path },
  { name: product.title, path: pagePath },
];
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  ogImage={product.images[0] ? socialImageFromAsset(product.images[0].src) : undefined}
  ogImageAlt={product.images[0]?.alt ?? metaTitle}
  jsonLd={[
    productSchema({
      name: product.title,
      description: metaDescription,
      url: pagePath,
      offerUrl: product.buyUrl,
      image: product.images[0]?.src,
      sku: 'halloween-private-cheats',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <ProductDetail product={product} breadcrumbs={breadcrumbs} />
</BaseLayout>
