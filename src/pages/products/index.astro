---
import '../../styles/product-cheat-page.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import { productHub, productPages } from '../../data/products';
import { resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '../../utils/schema';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCatalogGrid from '../../components/ProductCatalogGrid.astro';
import { productPath } from '../../utils/path';

const seo = resolvePageSeo('/products/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: productHub.path },
];

---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: productHub.title,
      description: productHub.description,
      url: productHub.path,
    }),
    breadcrumbSchema(breadcrumbs),
    itemListSchema(
      productPages.map((product) => ({
        name: product.title,
        url: productPath(product.slug),
      })),
    ),
  ]}
>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <div class="mt-6 max-w-3xl space-y-3">
        <h1 class="text-3xl font-bold uppercase md:text-4xl">{t.products.title}</h1>
        <p class="text-lg text-muted-foreground">{t.products.subtitle}</p>
      </div>

      <ProductCatalogGrid class="mt-10" />
    </div>
  </section>
</BaseLayout>
