---
import '../styles/product-cheat-page.css';
import { t } from '../i18n';
import SectionHeader from './SectionHeader.astro';
import ProductCatalogGrid from './ProductCatalogGrid.astro';

const s = t.products;
---

<section id="products" class="py-16 md:py-24" aria-labelledby="products-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader eyebrow={s.eyebrow} title={s.title} desc={s.subtitle} titleId="products-title" />
    <ProductCatalogGrid class="mt-10" />
  </div>
</section>
